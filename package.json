{
  "name": "nasjidwg",
  "version": "0.14.1",
  "description": "Pure-TypeScript DWG/DXF library with first-class Arabic and RTL text support. Runs in the browser, Node, and Electron with zero native dependencies. Every writable DWG release from R2.6 to R2018 — AC1021 included — and the ASCII DXF writer are validated externally in AutoCAD 2027 (opens clean, AUDIT 0 errors).",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Ahmed Elhagar",
  "homepage": "https://github.com/NASJI-Packages/nasjidwg#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NASJI-Packages/nasjidwg.git"
  },
  "bugs": {
    "url": "https://github.com/NASJI-Packages/nasjidwg/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "PROVENANCE.md",
    "docs/comparison.png",
    "docs/comparison.svg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "bench": "npm run build && node tools/bench.mjs",
    "cli": "node --experimental-strip-types src/cli.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "dwg",
    "dxf",
    "cad",
    "autocad",
    "arabic",
    "rtl",
    "typescript",
    "viewer",
    "asm",
    "acis",
    "browser"
  ],
  "bin": {
    "nasjidwg": "dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
